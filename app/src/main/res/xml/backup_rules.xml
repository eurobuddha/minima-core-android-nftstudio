<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   Nothing in this app needs to leave the device, and nothing here should survive a reinstall onto a node
   with different keys. allowBackup="false" already disables this; the excludes are explicit so the intent
   survives anyone flipping that flag back. What was being carried:
   only cache-dir shop drafts; vendor identity is held in memory and re-fetched each launch. The shared
         minima_api_prefs node pairing token was the one durable thing leaving the device
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
